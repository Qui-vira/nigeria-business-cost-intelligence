                  {
                    "value": "5. For five of nine costs, the cheapest place keeps changing",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "700",
                      "color": "#0E5A8A"
